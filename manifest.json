{
  "manifest_version": 3,
  "name": "Gridiron Edge",
  "version": "2.0",
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; frame-ancestors 'none'; img-src 'self' data: https://a.espncdn.com; font-src 'self'; media-src 'none'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://fantasy.espn.com https://site.api.espn.com https://api.sleeper.app"
  },
  "description": "Live auction and draft assistant for ESPN fantasy football. Reads your draft room and prices every bid against your roster.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://fantasy.espn.com/*"
  ],
  "background": {
    "service_worker": "chrome-extension/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fantasy.espn.com/*/draft*",
        "https://fantasy.espn.com/*/draft/draftroom*"
      ],
      "js": [
        "chrome-extension/content-isolated.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://fantasy.espn.com/*/draft*",
        "https://fantasy.espn.com/*/draft/draftroom*"
      ],
      "js": [
        "chrome-extension/content-main.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "Open Gridiron Edge",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "index.html"
      ],
      "matches": [
        "https://fantasy.espn.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
